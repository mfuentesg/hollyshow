{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Operator window: core plus every app command (the library, remote, windows, media and updater are only reachable from here)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-dispatch",
    "allow-query",
    "allow-get-snapshot",
    "allow-get-setting",
    "allow-set-setting",
    "allow-get-active-playlist-id",
    "allow-save-song",
    "allow-delete-song",
    "allow-import-songs",
    "allow-save-playlist",
    "allow-delete-playlist",
    "allow-save-theme",
    "allow-delete-theme",
    "allow-get-pairing",
    "allow-regenerate-pin",
    "allow-set-remote-enabled",
    "allow-set-pairing-role",
    "allow-set-pairing-ttl",
    "allow-set-remote-https",
    "allow-list-devices",
    "allow-kick-device",
    "allow-health",
    "allow-report-output-stats",
    "allow-startup-info",
    "allow-usage-report",
    "allow-export-library",
    "allow-import-library",
    "allow-list-bible-catalog",
    "allow-install-bible",
    "allow-import-bible",
    "allow-remove-bible",
    "allow-update-bible-version",
    "allow-reorder-bible-versions",
    "allow-open-output",
    "allow-open-stage",
    "allow-close-window",
    "allow-list-monitors",
    "allow-output-monitors",
    "allow-operator-monitor-index",
    "allow-media-search",
    "allow-media-categories",
    "allow-media-download",
    "allow-media-list",
    "allow-media-remove",
    "allow-media-credits",
    "allow-update-check",
    "allow-update-download",
    "allow-update-status",
    "allow-update-install-now",
    "allow-update-settings-get",
    "allow-update-settings-set"
  ]
}
